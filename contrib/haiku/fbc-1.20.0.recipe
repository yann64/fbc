SUMMARY="Compiler for the FreeBASIC programming language"
DESCRIPTION="FreeBASIC (fbc) is a free, multiplatform BASIC compiler with a \
syntax compatible with Microsoft QuickBasic. It supports procedural, \
object-oriented, and meta-programming, and provides a large standard \
runtime library plus thin bindings to popular C libraries.

Full console features (COLOR/LOCATE/INKEY$/etc., linked against Haiku's \
ncurses6 package) and ThreadCall (linked against Haiku's libffi) both work. \
SCREEN-mode graphics (gfxlib2) uses a native Haiku (BApplication/BWindow) \
driver: 32bpp truecolor and 8bpp indexed/palette SCREEN modes, keyboard \
(including F1-F12), mouse (position/buttons/wheel, show/hide cursor), \
window positioning, and ScreenSync/SCREENLIST all work. Repositioning the \
system cursor and OpenGL are not supported."
HOMEPAGE="https://freebasic.net/"
COPYRIGHT="2004-2025 The FreeBASIC development team"
LICENSE="GNU GPL v2"
REVISION="1"

SOURCE_URI="https://github.com/yann64/fbc/archive/refs/tags/haiku-$portVersion.tar.gz"
CHECKSUM_SHA256="6989aaf042a3ddc8b9bce88987b77ceaf3459fe412a187e2e12dd1499d199938"
SOURCE_DIR="fbc-haiku-$portVersion"

ARCHITECTURES="x86_64"

PROVIDES="
	fbc = $portVersion
	compiler(basic) = $portVersion
	cmd:fbc = $portVersion
	"
REQUIRES="
	haiku
	lib:libffi
	ncurses6
	"

BUILD_PREREQUIRES="
	haiku_devel
	cmd:gcc
	cmd:make
	libffi_devel
	ncurses6_devel
	"

BUILD_REQUIRES="$BUILD_PREREQUIRES"

BUILD()
{
	# No fbc package exists yet for Haiku (this port creates the first one),
	# so a clean haikuporter chroot has no native fbc to self-host from. The
	# source tree vendors pre-generated C (bootstrap/haiku-x86_64/*.c,
	# cross-emitted from this same source on Linux via
	# `fbc -target haiku-x86_64 -e -r`) precisely for this bring-up case --
	# same convention upstream fbc itself uses for new-target bootstrapping.
	# Compile that with the native gcc to get a first working fbc, then
	# self-host rebuild from the real .bas sources, matching the two-step
	# pattern in contrib/travis/build-and-test.sh. This vendored bootstrap
	# can be dropped in a future revision once a prior fbc-for-haiku release
	# exists to build against instead.
	make bootstrap-minimal $jobArgs
	mv bin/fbc bin/fbc1
	make clean-compiler
	make compiler FBC="bin/fbc1 -i inc" $jobArgs
	rm bin/fbc1
	make rtlib gfxlib2 $jobArgs
}

INSTALL()
{
	make install-compiler install-includes install-rtlib install-gfxlib2 prefix="$prefix"

	mkdir -p "$manDir/man1"
	cp "$sourceDir/doc/fbc.1" "$manDir/man1/fbc.1"
}
